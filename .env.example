# Used only to create admin on the first start; subsequent changes happen in the UI.
ADMIN_PASSWORD=
PUBLIC_URL=https://music.example.com
# Set false only for localhost/private-LAN HTTP development.
SECURE_COOKIES=true
# Matching 10-character identifiers for the active MusicKit P-256 .p8 key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_FILE=./secrets/AuthKey.p8
APPLE_STOREFRONT=us
WRAPPER_URL=http://host.docker.internal:8080
WRAPPER_DECRYPT_HOST=host.docker.internal
WRAPPER_DECRYPT_PORT=10020
BIND_ADDRESS=127.0.0.1
# Create this host directory as the UID/GID below before starting Compose.
BACKEND_DATA_DIR=./data
DATA_DIR=/data
BACKEND_UID=1000
BACKEND_GID=1000
MAX_TRACK_BYTES=268435456
MAX_CACHE_BYTES=536870912
