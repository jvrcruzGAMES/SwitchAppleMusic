# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEVICE_TOKEN=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_FILE=./secrets/AuthKey.p8
APPLE_STOREFRONT=us
APPLE_MUSIC_USER_TOKEN_FILE_HOST=./secrets/music_user_token
# Inside the backend container:
APPLE_MUSIC_USER_TOKEN_FILE=/run/secrets/music_user_token
# Run wrapper-v2 separately; do not expose its HTTP/decrypt ports publicly.
WRAPPER_URL=http://host.docker.internal:8080
WRAPPER_DECRYPT_HOST=host.docker.internal
WRAPPER_DECRYPT_PORT=10020
BIND_ADDRESS=127.0.0.1
# Set to the host user that owns the two secret files (id -u / id -g).
BACKEND_UID=1000
BACKEND_GID=1000
# Backend host cache limits (ALAC may need more space than AAC).
MAX_TRACK_BYTES=268435456
MAX_CACHE_BYTES=536870912
