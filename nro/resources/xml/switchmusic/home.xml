<?xml version="1.0" encoding="utf-8"?>
<brls:Box axis="column" width="100%" height="auto">
    <brls:Label text="MADE FOR LISTENING" fontSize="15" textColor="#FA4566" marginBottom="10"/>
    <brls:Label id="page/title" text="Find your next favorite." fontSize="34" textColor="#F4F5F7" marginBottom="10"/>
    <brls:Label id="page/subtitle" text="Search Apple Music, explore collections, and keep your music close." fontSize="19" textColor="#A9B0BF" marginBottom="24"/>
    <brls:Box axis="column" width="100%" height="auto" padding="28" cornerRadius="16" backgroundColor="#29212F" marginBottom="24">
        <brls:Label text="APPLE MUSIC" fontSize="14" textColor="#FFABB9" marginBottom="10"/>
        <brls:Label text="All your music. One place." fontSize="30" textColor="#F4F5F7" marginBottom="10"/>
        <brls:Label text="Songs, albums and playlists — ready to explore." fontSize="19" textColor="#C0C5D0" marginBottom="10"/>
        <brls:Box axis="row" marginTop="16">
            <brls:Button id="home/search" text="Search music" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" width="240" style="primary" marginRight="16"/>
            <brls:Button id="home/player" text="Open player" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" width="220" style="bordered"/>
        </brls:Box>
    </brls:Box>
    <brls:Box axis="column" width="100%" height="auto" id="home/library">
        <brls:Label text="YOUR COLLECTION" fontSize="14" textColor="#9099AA" marginBottom="10"/>
        <brls:Box axis="row">
            <brls:Button id="home/songs" text="Songs" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" grow="1" style="bordered" marginRight="12"/>
            <brls:Button id="home/albums" text="Albums" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" grow="1" style="bordered" marginRight="12"/>
            <brls:Button id="home/playlists" text="Playlists" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" grow="1" style="bordered" marginRight="12"/>
        </brls:Box>
    </brls:Box>
    <brls:Box axis="column" width="100%" height="auto" padding="22" cornerRadius="14" backgroundColor="#1C212D" id="home/connection">
        <brls:Label id="home/link-title" text="Make it personal" fontSize="23" textColor="#F4F5F7" marginBottom="10"/>
        <brls:Label id="home/link-detail" text="Sign in and link Apple Music to see your saved music." fontSize="18" textColor="#A9B0BF" marginBottom="10"/>
        <brls:Button id="home/account" text="Account &amp; settings" height="54" shrink="0" marginBottom="12" cornerRadius="10" fontSize="20" width="280" style="borderless"/>
    </brls:Box>
</brls:Box>
