<?xml version="1.0" encoding="utf-8"?>
<brls:AppletFrame id="shell" headerHidden="true" footerHidden="false">
    <brls:Box id="app" axis="column" width="100%" height="100%" backgroundColor="#12151C">
        <brls:Box axis="row" height="82" shrink="0" paddingLeft="32" paddingRight="32" alignItems="center" lineBottom="1" lineColor="#2A303D">
            <brls:Label text="SWITCH" fontSize="25" textColor="#F4F5F7"/>
            <brls:Label text="MUSIC" fontSize="25" textColor="#FA4566" marginLeft="6"/>
            <brls:Box grow="1"/>
            <brls:Label id="shell/account" text="Welcome" fontSize="17" textColor="#A9B0BF" singleLine="true"/>
        </brls:Box>
        <brls:Box axis="row" grow="1" minHeight="0">
            <brls:Box axis="column" width="220" height="100%" padding="20" shrink="0" backgroundColor="#181C25">
                <brls:Label text="LISTEN" fontSize="13" textColor="#9099AA" marginBottom="10" marginTop="12"/>
                <brls:Button id="nav/home" text="Discover" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                <brls:Button id="nav/search" text="Search" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                <brls:Button id="nav/player" text="Now playing" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                <brls:Box axis="column" width="100%" height="auto" id="nav/library">
                    <brls:Label text="YOUR LIBRARY" fontSize="13" textColor="#9099AA" marginBottom="10" marginTop="20"/>
                    <brls:Button id="nav/songs" text="Songs" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                    <brls:Button id="nav/albums" text="Albums" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                    <brls:Button id="nav/playlists" text="Playlists" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" focusRight="content"/>
                </brls:Box>
                <brls:Button id="nav/account" text="Account" height="46" shrink="0" marginBottom="6" cornerRadius="10" fontSize="18" style="borderless" textHorizontalAlign="left" marginTop="16" focusRight="content"/>
            </brls:Box>
            <brls:Box axis="column" grow="1" minWidth="0" paddingTop="24" paddingLeft="30" paddingRight="30">
                <brls:Label id="shell/status" text="Connect to your music server" fontSize="16" textColor="#A9B0BF" singleLine="true" marginBottom="18"/>
                <brls:ScrollingFrame id="scroll" grow="1" minHeight="0" scrollingBehavior="centered">
                    <brls:Box id="content" axis="column" width="100%" height="auto" padding="8" paddingBottom="30"/>
                </brls:ScrollingFrame>
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
