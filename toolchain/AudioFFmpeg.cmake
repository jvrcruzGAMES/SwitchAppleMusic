# Direct-FFmpeg player dependency. Deliberately independent of mpv's FFmpeg.
set(SWITCHMUSIC_AUDIO_FFMPEG_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../build-ffmpeg/switch" CACHE PATH "Isolated audio-only FFmpeg install")
get_filename_component(_audio_prefix "${SWITCHMUSIC_AUDIO_FFMPEG_PREFIX}" ABSOLUTE)
if(NOT EXISTS "${_audio_prefix}/config_components.h")
    message(FATAL_ERROR "Run scripts/build-audio-ffmpeg.py --target switch first")
endif()
file(STRINGS "${_audio_prefix}/config_components.h" _audio_decoders REGEX "^#define CONFIG_[A-Z0-9_]+_DECODER 1$")
list(SORT _audio_decoders)
if(NOT "${_audio_decoders}" STREQUAL "#define CONFIG_AAC_DECODER 1;#define CONFIG_ALAC_DECODER 1")
    message(FATAL_ERROR "Audio profile must contain exactly AAC and ALAC decoders")
endif()
add_library(switchmusic_audio_ffmpeg INTERFACE)
add_library(SwitchMusic::AudioFFmpeg ALIAS switchmusic_audio_ffmpeg)
target_include_directories(switchmusic_audio_ffmpeg INTERFACE "${_audio_prefix}/include")
foreach(_audio_lib avformat avcodec swresample avutil)
    if(NOT EXISTS "${_audio_prefix}/lib/lib${_audio_lib}.a")
        message(FATAL_ERROR "Missing ${_audio_lib} archive in ${_audio_prefix}")
    endif()
    target_link_libraries(switchmusic_audio_ffmpeg INTERFACE "${_audio_prefix}/lib/lib${_audio_lib}.a")
endforeach()
target_link_libraries(switchmusic_audio_ffmpeg INTERFACE nx m)
